{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ky",
  "version": "0.3.5",
  "identifier": "com.kyvault.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ky",
        "dragDropEnabled": false,
        "width": 1024,
        "height": 680,
        "minWidth": 680,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "windowEffects": {
          "effects": [
            "underWindowBackground"
          ],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCRDExMTlCNDgwN0I2RkQKUldUOXRnZElteEhSbTVoMU5XZzJLZ0ErcjF1RzgwTjR3alF0YWt2ajN6Y0dkcDhYaHpSdS9HZEYK",
      "endpoints": [
        "https://raw.githubusercontent.com/webkubor/kyvault/main/updater/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "Local clipboard history, snippets and secrets",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "resources": {
      "../browser/extension/": "flash-browser/extension/",
      "../browser/install-host.sh": "flash-browser/install-host.sh"
    }
  }
}
