{
  "identifier": "main",
  "description": "Only the local Ky window can use desktop commands and receive events.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:app:allow-set-app-theme",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://github.com/webkubor/kyvault/releases/tag/desktop-v*" }] },
    "allow-flash-browser-setup","allow-flash-sound","allow-flash-choose-app","allow-flash-apps","allow-flash-app-rule","allow-flash-history",
    "allow-account-status",
    "allow-account-login",
    "allow-account-create",
    "allow-account-bind",
    "allow-account-sync",
    "allow-account-unbind",
    "allow-workspace-list",
    "allow-workspace-read",
    "allow-workspace-save",
    "allow-workspace-delete",
    "allow-export-workspace-file",
    "allow-copy-share-png",
    "allow-export-share-png",
    "allow-snapshot",
    "allow-capture-clipboard",
    "allow-set-monitoring",
    "allow-preview-text",
    "allow-save-text",
    "allow-delete-entry",
    "allow-restore-entry",
    "allow-copy-entry",
    "allow-get-entry-image",
    "allow-get-app-info",
    "allow-check-update",
    "allow-install-update",
    "allow-copy-reference",
    "allow-copy-secret",
    "allow-show-secret",
    "allow-save-secret",
    "allow-save-secret-with-meta",
    "allow-delete-secret",
    "allow-lock-app",
    "allow-unlock-app",
    "allow-clear-history",
    "allow-touch-activity",
    "allow-set-ui-language",
    "allow-pending-requests",
    "allow-fulfill-request",
    "allow-discard-request"
  ]
}