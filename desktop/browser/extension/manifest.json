{
  "manifest_version": 3,
  "name": "Ky 闪记",
  "version": "1.0.0",
  "key": "",
  "incognito": "not_allowed",
  "permissions": [
    "activeTab",
    "contextMenus",
    "nativeMessaging",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "worker.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ky 闪记"
  }
}
